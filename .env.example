# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bnb_agents

# Discovery
SCAN8004_API_BASE=https://8004scan.io/api/v1/public
SCAN8004_API_KEY=
SCAN8004_DETAIL_LIMIT=8
DISCOVERY_CACHE_SECONDS=300

# BNB Agent SDK
NETWORK=bsc-testnet
BNB_CHAIN_ID=97
# The SDK 0.5.0 preset still points at a retired hostname; use the current
# official BSC testnet endpoint unless your deployment provides another RPC.
RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
WALLET_PASSWORD=
PRIVATE_KEY=
WALLET_ADDRESS=
AGENT_COMMERCE_ADAPTER=mock
JOB_API_KEY=

# Optional LLM intent parser. MVP can use deterministic parsing first.
OPENAI_API_KEY=
